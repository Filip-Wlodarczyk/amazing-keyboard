<?xml version="1.0" encoding="utf-8"?>
<component>
  <name>org.freedesktop.IBus.AMKB</name>
  <description>Amazing Keyboard - AI autocomplete</description>
  <exec>@EXEC@</exec>
  <version>0.1.0</version>
  <author>amkb</author>
  <license>MIT</license>
  <homepage></homepage>
  <textdomain>amkb</textdomain>
  <engines>
    <engine>
      <name>amkb</name>
      <language>pl</language>
      <license>MIT</license>
      <author>amkb</author>
      <icon>input-keyboard</icon>
      <layout>@LAYOUT@</layout>
      <layout_variant>@VARIANT@</layout_variant>
      <longname>Amazing Keyboard (AI)</longname>
      <description>Gray AI suggestions, Tab inserts</description>
      <rank>0</rank>
      <symbol>AI</symbol>
    </engine>
  </engines>
</component>
